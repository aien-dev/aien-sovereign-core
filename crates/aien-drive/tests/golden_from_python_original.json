    {
     "name": "run_command",
     "arguments": {
      "command": "echo hi\nthere"
     }
    }
   ]
  }
 ],
 "dispatch": [
  {
   "name": "run_command",
   "args": {
    "command": "echo out; echo err 1>&2; exit 3",
    "cwd": "{TMP}"
   },
   "result": {
    "exit_code": 3,
    "stdout": "out\n",
    "stderr": "err\n"
   }
  },
  {
   "name": "run_command",
   "args": {
    "command": "printf 'x%.0s' $(seq 1 5000)",
    "cwd": "{TMP}"
   },
   "result": {
    "exit_code": 0,
    "stdout": "",
    "stderr": ""
   }
  },
  {
   "name": "view_file",
   "args": {
    "path": "{TMP}/f.txt",
    "start_line": 2,
    "end_line": 3
   },
   "result": {
    "path": "{TMP}/f.txt",
    "total_lines": 4,
    "lines": "two\nthree\n"
   }
  },
  {
   "name": "view_file",
   "args": {
    "path": "{TMP}/f.txt"
   },
