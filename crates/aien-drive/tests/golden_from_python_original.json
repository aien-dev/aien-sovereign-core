    {
     "name": "goal",
     "arguments": {
      "action": "done"
     }
    }
   ]
  },
  {
   "text": "bare {\"name\": \"view_file\", \"arguments\": {\"path\": \"a.txt\"}} text",
   "calls": [
    {
     "name": "view_file",
     "arguments": {
      "path": "a.txt"
     }
    }
   ]
  },
  {
   "text": "single {'name': 'list_dir', 'arguments': {'path': '.'}}",
   "calls": []
  },
  {
   "text": "<tool_call>{not json}</tool_call>",
   "calls": []
  },
  {
   "text": "nothing here",
   "calls": []
  },
  {
   "text": "multi\n<tool_call>\n{\"name\":\"run_command\",\"arguments\":{\"command\":\"echo hi\\nthere\"}}\n</tool_call>",
