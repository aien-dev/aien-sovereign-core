# The rxc_host C ABI contract (omega src/runtime/rxc_host_abi.h) that aien-omega-compose
# mirrors in src/ffi.rs. Checked from both sides: tests/abi_manifest.rs (Rust declarations,
# every build) and build.rs (pinned C header, compiled layout probe, archive symbols).
# Format: aien-abi-conformance src/manifest.rs. Regenerate the fact lines from Rust with
#   AIEN_ABI_BLESS=1 cargo test -p aien-omega-compose --test abi_manifest
# only together with the omega.lock change that makes the C side agree.
abi rxc_host 2
header src/runtime/rxc_host_abi.h
struct RxcHostInfo 88 8
field RxcHostInfo abi_version 0 4 u32 1
field RxcHostInfo machine_root 4 1 u8 1
field RxcHostInfo machine_id 5 32 u8 32
field RxcHostInfo machine_id_was_stored 40 4 u32 1
field RxcHostInfo tail_torn 44 4 u32 1
field RxcHostInfo opened 48 4 u32 1
field RxcHostInfo open_rc 52 4 i32 1
field RxcHostInfo records 56 8 u64 1
field RxcHostInfo recovered_record 64 8 u64 1
field RxcHostInfo rolled_back 72 4 u32 1
field RxcHostInfo recovered_completed 76 4 u32 1
field RxcHostInfo anchor_unknown 80 4 u32 1
field RxcHostInfo n_skills 84 4 u32 1
struct RxcHostResult 168 8
field RxcHostResult run_rc 0 4 i32 1
field RxcHostResult outcome 4 4 i32 1
field RxcHostResult committed 8 4 u32 1
field RxcHostResult n_branches 12 4 u32 1
field RxcHostResult branches_reclaimed 16 4 u32 1
field RxcHostResult winner 20 4 u32 1
field RxcHostResult winner_skill 24 4 u32 1
field RxcHostResult aegis_pass_mask 28 4 u32 1
field RxcHostResult task 32 8 u64 1
field RxcHostResult result 40 8 u64 1
field RxcHostResult cx_goal 48 8 u64 1
field RxcHostResult cx_candidate 56 16 u64 2
field RxcHostResult cx_evidence 72 8 u64 1
field RxcHostResult cx_promotion 80 8 u64 1
field RxcHostResult cx_admission 88 16 u64 2
field RxcHostResult winner_digest 104 32 u8 32
field RxcHostResult record_digest 136 32 u8 32
struct RxcHostRecord 120 8
field RxcHostRecord id 0 8 u64 1
field RxcHostRecord cls 8 4 u32 1
field RxcHostRecord kind 12 4 u32 1
field RxcHostRecord subject 16 8 u64 1
field RxcHostRecord t 24 8 u64 1
field RxcHostRecord generation 32 8 u64 1
field RxcHostRecord tag 40 8 u64 1
field RxcHostRecord links 48 32 u64 4
field RxcHostRecord n_payload 80 4 u32 1
field RxcHostRecord verified 84 4 u32 1
field RxcHostRecord digest 88 32 u8 32
struct RxcHostRepair 160 8
field RxcHostRepair repaired 0 4 u32 1
field RxcHostRepair tail_torn 4 4 u32 1
field RxcHostRepair anchor_present 8 4 u32 1
field RxcHostRepair cause 12 4 i32 1
field RxcHostRepair opens 16 4 u32 1
field RxcHostRepair open_rc 20 4 i32 1
field RxcHostRepair rolled_back 24 4 u32 1
field RxcHostRepair recovered_completed 28 4 u32 1
field RxcHostRepair cut_lo 32 8 u64 1
field RxcHostRepair cut_hi 40 8 u64 1
field RxcHostRepair partial_records 48 8 u64 1
field RxcHostRepair anchor_records 56 8 u64 1
field RxcHostRepair records_kept 64 8 u64 1
field RxcHostRepair dropped_records 72 8 u64 1
field RxcHostRepair event_id 80 8 u64 1
field RxcHostRepair cut_bytes_kept 88 8 u64 1
field RxcHostRepair cut_sha256 96 32 u8 32
field RxcHostRepair anchor_head 128 32 u8 32
const RXC_HOST_ABI_VERSION 2
const RXC_HOST_MAX_HANDLES 4
const RXC_HOST_MAX_SKILLS 2
const RXC_HOST_NAME_MAX 64
const RXC_HOST_NONE 4294967295
const RXC_HOST_SUBJECT_GOAL 1
const RXC_HOST_SUBJECT_STATE 5
const RXC_HOST_SUBJECT_HOST 0
const RXC_HOST_TAG_REPAIR_TAIL 1
const RXC_HOST_NOTE_CONSTRAINT 2
const RXC_HOST_NOTE_AUTHORIZATION 3
const RXC_HOST_NOTE_EFFECT 4
const RXC_HOST_NOTE_MAX 16384
const RXC_HOST_NP_LEN 0
const RXC_HOST_NP_SHA 1
const RXC_HOST_NP_BYTES 5
const RXC_HOST_RP_CUT_LO 0
const RXC_HOST_RP_CUT_HI 1
const RXC_HOST_RP_DROPPED 5
const RXC_HOST_RP_CAUSE 6
const RXC_HOST_OK 0
const RXC_HOST_E_ARG -1
const RXC_HOST_E_IDENTITY -2
const RXC_HOST_E_TORN -3
const RXC_HOST_E_OPEN -4
const RXC_HOST_E_FULL -5
const RXC_HOST_E_STATE -6
const RXC_HOST_E_RUN -7
const RXC_HOST_E_NOMEM -8
const RXC_HOST_E_NOT_FOUND -9
const RXC_HOST_E_DIGEST -10
const RXC_HOST_E_REPLAY -11
fnptr RxcHostSkillFn fn(*mut c_void, u64, *mut u64) -> i32
fnptr RxcHostVerifyFn fn(*mut c_void, u64, u64) -> i32
fn rxc_host_abi_layout fn(*mut u32) -> u32
fn rxc_host_open fn(*const c_char, u32, *const u8, usize, u64, u32, *mut *mut RxcHost, *mut RxcHostInfo) -> i32
fn rxc_host_register_skill fn(*mut RxcHost, *const c_char, *const u8, u64, RxcHostSkillFn, *mut c_void) -> i32
fn rxc_host_set_verify fn(*mut RxcHost, RxcHostVerifyFn, *mut c_void) -> i32
fn rxc_host_run fn(*mut RxcHost, u64, u64, *mut RxcHostResult) -> i32
fn rxc_host_recall fn(*mut RxcHost, u64, *mut RxcHostRecord, u32, *mut u32, *mut u64) -> i32
fn rxc_host_record fn(*mut RxcHost, u64, *mut RxcHostRecord) -> i32
fn rxc_host_payload fn(*mut RxcHost, u64, *mut u64, u32) -> i32
fn rxc_host_info fn(*mut RxcHost, *mut RxcHostInfo) -> i32
fn rxc_host_note fn(*mut RxcHost, u32, *const u64, *const u8, usize, *mut u64) -> i32
fn rxc_host_recover fn(*const c_char, u32, *const u8, usize, *mut RxcHostRepair) -> i32
fn rxc_host_close fn(*mut RxcHost) -> ()
fn rxc_host_set_wait_ms fn(*mut RxcHost, u32) -> i32
