{
  "engineering_fix": {
    "description": "Reproduce, prove with a failing test, implement, retest, then review. Software owns the sequence.",
    "initial": "reproduce",
    "states": {
      "reproduce": { "next": ["regression_fail"] },
      "regression_fail": { "next": ["implement"] },
      "implement": { "next": ["retest"] },
      "retest": { "next": ["review", "implement"] },
      "review": { "next": ["done", "implement"] },
      "done": { "next": [] }
    },
    "required_schema": "engineering_fix",
    "required_evals_on_done": ["reproduction_present"]
  },
  "research_handoff": {
    "description": "Collect claims with excerpts, validate schema, eval sources, then deliver.",
    "initial": "collect",
    "states": {
      "collect": { "next": ["validate"] },
      "validate": { "next": ["eval_sources", "collect"] },
      "eval_sources": { "next": ["deliver", "collect"] },
      "deliver": { "next": ["done"] },
      "done": { "next": [] }
    },
    "required_schema": "research_handoff",
    "required_evals_on_done": ["required_evidence", "slop_gate"]
  },
  "harness_change": {
    "description": "Change a model, tool, prompt, or eval only after failure replay passes.",
    "initial": "propose",
    "states": {
      "propose": { "next": ["replay"] },
      "replay": { "next": ["apply", "propose"] },
      "apply": { "next": ["verify"] },
      "verify": { "next": ["done", "propose"] },
      "done": { "next": [] }
    },
    "required_schema": "harness_change",
    "required_evals_on_done": ["required_evidence"]
  },
  "python_pipeline": {
    "description": "Middle path: write and run Python in the persistent kernel. Failed evals must remember (Cortex + KB) before refine. Prompt edits are optional and last.",
    "initial": "write",
    "states": {
      "write": { "next": ["run"] },
      "run": { "next": ["eval"] },
      "eval": { "next": ["deliver", "remember"] },
      "remember": { "next": ["refine"] },
      "refine": { "next": ["run"] },
      "deliver": { "next": ["done"] },
      "done": { "next": [] }
    },
    "required_schema": "python_result",
    "required_evals_on_done": ["required_evidence"]
  }
}
