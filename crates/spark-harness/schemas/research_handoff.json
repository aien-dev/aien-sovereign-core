{
  "$id": "atlas://schemas/research_handoff",
  "title": "research_handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["question", "claims", "sources", "open_questions"],
  "properties": {
    "question": { "type": "string", "minLength": 8 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "source_url", "excerpt"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "source_url": { "type": "string", "minLength": 8 },
          "excerpt": { "type": "string", "minLength": 12 }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 8 }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
