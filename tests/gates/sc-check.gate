# tests/gates/sc-check.gate
# Mirrors hosted: ci.yml verify 'cargo check --workspace --all-targets'
gate: SC-CHECK
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - Cargo.toml
  - Cargo.lock
  - rust-toolchain.toml
  - crates/
  - tools/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["check"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine
