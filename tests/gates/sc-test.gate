# tests/gates/sc-test.gate
# Mirrors hosted: ci.yml verify 'AIEN_DEV_FALLBACK=1 cargo test --workspace --verbose -- --test-threads=1' (hosted verify job 543 s total)
gate: SC-TEST
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - Cargo.toml
  - Cargo.lock
  - rust-toolchain.toml
  - crates/
  - tools/
  - tests/gates/
  - scripts/
run:
  exec: tests/gates/run.sh
  args: ["test"]
expects:
  exit: 0
  verdict: PASS
timeout: 60m
exactness: EXACT
cache_scope: machine
