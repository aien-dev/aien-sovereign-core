# tests/gates/sc-verify-closure.gate
# Mirrors hosted: verify-closure.yml: build and test aien-closure, run verify-closure on the seeded fixture (hosted 28 s)
gate: SC-VERIFY-CLOSURE
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - crates/aien-closure/
  - crates/aien-proof/
  - Cargo.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["verify-closure"]
expects:
  exit: 0
  verdict: PASS
timeout: 15m
exactness: EXACT
cache_scope: machine
