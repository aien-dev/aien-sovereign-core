# tests/gates/sc-agent-preflight.gate
# Mirrors hosted: ci.yml verify 'Run Required Agent Preflight' (AIEN_PROOF_OFF=1 AIEN_DEV_FALLBACK=1, developer context; merged-tree on pushes to main)
# cache: never because the preflight reads branch state, not only tracked files.
gate: SC-AGENT-PREFLIGHT
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - scripts/
  - Cargo.toml
  - Cargo.lock
  - rust-toolchain.toml
  - crates/
  - tools/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["agent-preflight"]
expects:
  exit: 0
  verdict: PASS
timeout: 20m
exactness: EXACT
cache_scope: machine
cache: never
