# tests/gates/sc-anti-slop.gate
# Mirrors hosted: ci.yml verify 'Enforce Sovereign Voice and Anti-Slop Invariant' over crates/ docs/ README.md (always-run)
gate: SC-ANTI-SLOP
manifest_version: 2
owner: aien-sovereign-core
requires:
  - portable
inputs:
  - crates/
  - docs/
  - README.md
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["anti-slop"]
expects:
  exit: 0
  observe: ["dash_hits == 0"]
  verdict: PASS
timeout: 2m
exactness: EXACT
cache_scope: portable
