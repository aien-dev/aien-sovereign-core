# tests/gates/sc-preflight-guard.gate
# Mirrors hosted: ci.yml verify 'bash scripts/test-preflight-branch-guard.sh'
gate: SC-PREFLIGHT-GUARD
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - scripts/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["preflight-guard"]
expects:
  exit: 0
  verdict: PASS
timeout: 10m
exactness: EXACT
cache_scope: machine
