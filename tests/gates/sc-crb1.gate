# tests/gates/sc-crb1.gate
# Mirrors hosted: crumb-visible-conformance.yml: crumbs visible_conformance with the aien-protocols corpus at b50c00d (hosted 26 s)
gate: SC-CRB1
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - crates/crumbs/
  - Cargo.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["crb1"]
expects:
  exit: 0
  verdict: PASS
timeout: 15m
exactness: EXACT
cache_scope: machine
