# tests/gates/sc-pins-selftest.gate
# Mirrors hosted: ci.yml verify 'bash scripts/test-pins.sh'
gate: SC-PINS-SELFTEST
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - scripts/pins.sh
  - scripts/test-pins.sh
  - omega.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["pins-selftest"]
expects:
  exit: 0
  verdict: PASS
timeout: 10m
exactness: EXACT
cache_scope: machine
