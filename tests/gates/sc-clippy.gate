# tests/gates/sc-clippy.gate
# Mirrors hosted: ci.yml verify 'cargo clippy --workspace --all-targets -- -D warnings'
gate: SC-CLIPPY
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - Cargo.toml
  - Cargo.lock
  - rust-toolchain.toml
  - crates/
  - tools/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["clippy"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine
