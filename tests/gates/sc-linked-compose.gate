# tests/gates/sc-linked-compose.gate
# Mirrors hosted: ci.yml linked-compose: scripts/test-linked-compose.sh with omega at omega.lock, physics and aienos at omega's locks (hosted 241 s)
# cache: never because the pinned sibling sources are outside this repository; omega.lock is the input that names them.
gate: SC-LINKED-COMPOSE
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - omega.lock
  - scripts/test-linked-compose.sh
  - scripts/pins.sh
  - Cargo.toml
  - Cargo.lock
  - rust-toolchain.toml
  - crates/
  - tools/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["linked-compose"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine
cache: never
