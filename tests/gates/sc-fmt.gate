# tests/gates/sc-fmt.gate
# Mirrors hosted: ci.yml verify 'cargo fmt --all -- --check'
gate: SC-FMT
manifest_version: 2
owner: aien-sovereign-core
requires:
  - portable
inputs:
  - Cargo.toml
  - Cargo.lock
  - rust-toolchain.toml
  - crates/
  - tools/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["fmt"]
expects:
  exit: 0
  verdict: PASS
timeout: 5m
exactness: EXACT
cache_scope: portable
