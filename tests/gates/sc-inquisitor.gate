# tests/gates/sc-inquisitor.gate
# Mirrors hosted: sovereign-inquisitor.yml (pull_request_target): builds spark-inquisitor and reviews the PR diff fetched with GITHUB_TOKEN
# requires: operator because the review needs a GitHub pull request diff and token (pull_request_target context) that do not exist locally.
gate: SC-INQUISITOR
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
  - operator
inputs:
  - crates/spark-inquisitor/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["inquisitor"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine
