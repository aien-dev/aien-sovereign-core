# tests/gates/sc-kv-props.gate
# Mirrors hosted: hardening.yml kv-props: aien-replay kv_ownership_props + run_mutants.sh native (hosted 43 s)
gate: SC-KV-PROPS
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - crates/aien-replay/
  - crates/aien-kv-cache/
  - crates/aien-capability/
  - crates/aien-platform/
  - crates/aien-platform-linux/
  - Cargo.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["kv-props"]
expects:
  exit: 0
  verdict: PASS
timeout: 15m
exactness: EXACT
cache_scope: machine
