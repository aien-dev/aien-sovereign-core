# tests/gates/sc-miri.gate
# Mirrors hosted: hardening.yml miri: cargo +nightly miri test for aien-capability and aien-kv-cache + run_mutants.sh miri (hosted 1622 s)
# requires: operator in addition to host because the nightly miri component is not installed on this machine (rustup component add miri --toolchain nightly); the operator decides whether to install it. Hosted installs it on every run.
gate: SC-MIRI
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
  - operator
inputs:
  - crates/aien-capability/
  - crates/aien-kv-cache/
  - crates/aien-replay/
  - Cargo.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["miri"]
expects:
  exit: 0
  verdict: PASS
timeout: 60m
exactness: EXACT
cache_scope: machine
