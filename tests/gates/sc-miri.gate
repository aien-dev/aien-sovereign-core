# tests/gates/sc-miri.gate
# Mirrors hosted: hardening.yml miri: cargo +nightly miri test for aien-capability and aien-kv-cache + run_mutants.sh miri (hosted 1622 s)
# requires: host only. The nightly miri component is installed on the Spark (rustup component add miri --toolchain nightly, miri 0.1.0 2026-09-22); it was an operator gate until 2026-10-16 while that was not the case. Hosted installs it on every run.
gate: SC-MIRI
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - crates/aien-capability/
  - crates/aien-kv-cache/
  - crates/aien-replay/
  - Cargo.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["miri"]
expects:
  exit: 0
  verdict: PASS
timeout: 60m
exactness: EXACT
cache_scope: machine
