# tests/gates/sc-zero-cuda.gate
# Mirrors hosted: ci.yml verify 'Zero-CUDA Gate': zero-cuda-gate.sh --self-test, cargo build -p aien-cli, zero-cuda-gate.sh on the binary (always-run)
gate: SC-ZERO-CUDA
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - scripts/zero-cuda-gate.sh
  - Cargo.toml
  - Cargo.lock
  - rust-toolchain.toml
  - crates/
  - tools/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["zero-cuda"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine
