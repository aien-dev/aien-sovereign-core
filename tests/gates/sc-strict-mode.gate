# tests/gates/sc-strict-mode.gate
# Mirrors hosted: ci.yml verify 'Strict-Mode Controls (no AIEN_DEV_FALLBACK)': aien-inference-abi lib + attention_wiring + transformer_parity, aien-inference-runtime strict_real_model
gate: SC-STRICT-MODE
manifest_version: 2
owner: aien-sovereign-core
requires:
  - host
inputs:
  - Cargo.toml
  - Cargo.lock
  - crates/aien-inference-abi/
  - crates/aien-inference-runtime/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["strict-mode"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine
