# Mutations of tools/aien-test/src/*.rs. Format: id<TAB>file<TAB>sed expression<TAB>what it models.
# Each must be KILLED (a unit test fails) for run_mutants.sh to pass.
dirty_tree_not_refused	runner.rs	s#!before.is_empty() && !opts.allow_dirty#false#	a dirty tree is no longer refused
timeout_not_enforced	process.rs	s#rx.recv_timeout(spec.timeout)#rx.recv().map_err(|_| mpsc::RecvTimeoutError::Disconnected)#	the wall-clock timeout never fires
rule_mismatch_passes	verdict.rs	s#position(|r| !r.1)#position(|_r| false)#	a failed expectation rule still yields PASS
receipt_overwrite_allowed	evidence.rs	s#opts.write(true).create_new(true).mode(0o444);#opts.write(true).create(true).truncate(true).mode(0o444);#	an existing receipt can be overwritten
exit_status_ignored	verdict.rs	s#} else if f.exit_status != Some(m.expect_exit) {#} else if false {#	a wrong exit status is not a failure
head_move_ignored	runner.rs	s#facts.head_moved = head_after != commit;#facts.head_moved = false;#	HEAD moving during the run is not noticed
tree_change_ignored	runner.rs	s#facts.tree_changed_after = after != before;#facts.tree_changed_after = false;#	a run that dirties the tree is not noticed
kill_leader_only	process.rs	s#libc::kill(-pid, sig);#libc::kill(pid, sig);#	timeout kills the leader but not its process group
escape_hex_uppercase	evidence.rs	s#u{:04x}#u{:04X}#	canonical encoding escapes control characters with upper-case hex
duplicate_key_allowed	manifest.rs	s#if entries.iter().any(|e| e.key == k) {#if false {#	a repeated top-level key is accepted
unknown_key_allowed	manifest.rs	s#if !KNOWN.contains(&e.key.as_str()) {#if false {#	an unknown top-level key is ignored
missing_exec_ignored	verdict.rs	s#if !f.exec_exists {#if false {#	a missing run.exec is not MISSING_IMPLEMENTATION
last_value_becomes_first	verdict.rs	s#compare(rule.op, vals\[vals.len() - 1\], &rule.value)#compare(rule.op, vals[0], \&rule.value)#	a repeated observation uses the first value, not the last
evidence_inside_not_refused	runner.rs	s#let evidence_inside = resolve(&opts.evidence_dir).starts_with(resolve(root));#let evidence_inside = false;#	evidence may be written inside the tree under test
operator_gate_not_blocked	verdict.rs	s#if m.requires.iter().any(|r| r == "operator") {#if false {#	a gate needing an operator runs anyway
timeout_checked_after_exit	verdict.rs	s#let (verdict, reason) = if f.timed_out {#let (verdict, reason) = if false {#	a timed-out run is reported as rc_nonzero, not timeout
discover_ignores_gate_files	runner.rs	s#} else if ft.is_file() && name.ends_with(".gate") {#} else if false {#	the walk finds no .gate file, so a repository-wide parse check silently covers nothing
discover_not_recursive	runner.rs	s#walk(&path, out);#let _ = \&path;#	the walk does not descend into directories, so gates under crates/ or tests/ are never parsed
unknown_child_key_allowed	manifest.rs	s#if !allowed.contains(&k.as_str()) {#if false {#	a mistyped child key such as exce under run is not rejected
dep_blocked_ignored	verdict.rs	s#return Some((v, format!("DEP_BLOCKED:{d}")));#return Some((Verdict::NotRun, format!("DEP_NOT_PASS:{d}")));#	a blocked dependency no longer passes its blocked verdict on
dep_not_pass_ignored	verdict.rs	s#\.find(|d| dep_verdict(&f.deps, d) != Some(Verdict::Pass))#.find(|_d| false)#	a gate runs although a dependency is not PASS
no_hardware_not_blocked	verdict.rs	s#"gb10" if !f.gb10_present => {#"gb10" if false => {#	a gb10 gate on a machine without the GPU is not BLOCKED_HARDWARE
campaign_takes_the_mildest	verdict.rs	s#\.max_by_key(|v| v.exit_code())#.min_by_key(|v| v.exit_code())#	a campaign reports its mildest verdict instead of its worst
cycle_not_detected	graph.rs	s#if order.len() != nodes.len() {#if false {#	a dependency cycle is accepted as a graph
topo_order_takes_highest_first	graph.rs	s#ready\.pop_first()#ready.pop_last()#	the topological order is no longer lowest-id first and stable
gb10_timeout_enforced	runner.rs	s#enforce_timeout: m.pool() != "gb10",#enforce_timeout: true,#	a gb10 job is killed at its timeout
quiet_flag_ignored	resources.rs	s#if fs::symlink_metadata(flag).is_ok() {#if false {#	the quiet flag no longer stops a GPU job
gpu_lock_shared	resources.rs	s#libc::LOCK_EX | libc::LOCK_NB#libc::LOCK_SH | libc::LOCK_NB#	two GPU jobs can hold the lock at once
slot_released_twice	resources.rs	s#\*free += 1;#*free += 2;#	finishing a job frees two pool slots instead of one
stale_receipt_counts_as_pass	why.rs	s#Evidence::Other(_) => State::Stale,#Evidence::Other(_) => State::Pass,#	why reports a receipt from another commit as PASS
pass_over_failed_dependency	why.rs	s#let state = if own == State::Pass && !deps_pass {#let state = if false {#	why reports PASS although a dependency is not PASS
gpu_release_not_gated	resources.rs	s#let _gate = crate::process::spawn_gate();#let _gate = ();#	the GPU guard closes its lock descriptors without the spawn gate, so a child between fork and exec can keep the lock held after the release
spawn_not_gated	process.rs	s#let _gate = spawn_gate();#let _gate = ();#	child spawns no longer take the spawn gate, so a lock release does not wait for a child between fork and exec
cache_ignores_input_digest	cache.rs	s#"build_inputs_digest": e.build_inputs_digest,#"build_inputs_digest": "",#	the cache key ignores the declared input files, so a changed input is still a hit
cache_ignores_program	cache.rs	s#"binary_sha256": e.binary_sha256,#"binary_sha256": "",#	the cache key ignores the program, so an edited script is still a hit
cache_ignores_manifest	cache.rs	s#"manifest_digest": e.manifest_digest,#"manifest_digest": "",#	the cache key ignores the manifest, so an edited gate contract is still a hit
cache_ignores_machine	cache.rs	s#"machine_digest": e.machine_digest,#"machine_digest": "",#	the cache key ignores the machine, so a result from other hardware is a hit
cache_ignores_dependencies	cache.rs	s#"dependencies": deps,#"dependencies": [],#	the cache key ignores dependency receipts, so a gate resting on a changed dependency is a hit
cache_dependency_not_followed_to_origin	cache.rs	s#Some(r) if r.value\["volatile"\]\["cache"\]\["reused"\] == true => #Some(r) if r.value["volatile"]["cache"]["reused"] == "never" => #	a reused dependency keeps its own new digest, so every dependent misses and a whole graph is never reused
cache_args_override_not_in_key	cache.rs	s#if let Some(args) = &e.args_override {#if let Some(args) = \&None::<Vec<String>> {#	a run with replacement args gets the same key as the ordinary run
cache_stored_key_trusted	cache.rs	s#if recomputed.as_deref() != Some(key) {#if false {#	a receipt is believed when it claims a key, without hashing its own contents
cache_reused_receipt_is_source	cache.rs	s#if vol\["cache"\]\["reused"\] != false {#if false {#	a reuse receipt can itself be the source of a later reuse
cache_not_run_receipt_reused	cache.rs	s#if !matches!(src.verdict(), Some(Verdict::Pass | Verdict::Fail)) {#if false {#	a NOT_RUN or BLOCKED receipt is reused as if it were an experiment
cache_dirty_source_trusted	cache.rs	s#if core\["tree_clean_before"\] != true || core\["tree_clean_after"\] != true {#if false {#	a receipt made on a dirty tree can be reused
cache_timeout_source_trusted	cache.rs	s#if vol\["timeout_exceeded"\] != false {#if false {#	a run that went past its time limit can be reused
cache_env_ignored	cache.rs	s#if &core\["env"\] != env {#if false {#	a result made under other compiler flags or locale is reused
cache_blob_check_removed	cache.rs	s#Some(sha) if store.blob_exists(sha) => {}#Some(_) => {}#	a result whose logs are gone from the store is reused
cache_never_ignored	cache.rs	s#if !cache_allowed {#if false {#	a gate that says cache: never is reused anyway
cache_reuse_keeps_old_commit	cache.rs	s#core\["commit"\] = json!(commit);#let _ = commit;#	a reuse receipt still names the old commit, so the new commit looks unchecked
cache_dirty_tree_looks_up	runner.rs	s#if mode == cache::Mode::Allow \&\& (opts.args_override.is_some() || !tree_clean) {#if false {#	a tree with uncommitted changes (or replacement args) still consults the cache
cache_no_cache_ignored	runner.rs	s#cache::policy(m.cache_allowed, opts.no_cache)#cache::policy(m.cache_allowed, false)#	--no-cache does not force a fresh run
identity_machine_scope_ignored	identity.rs	s#CacheScope::Machine => b.machine_digest.clone(),#CacheScope::Machine => String::new(),#	a machine-scoped check id no longer depends on the machine, so a result from another machine is reused
identity_dependencies_dropped	identity.rs	s#"dependency_check_ids": deps,#"dependency_check_ids": Vec::<String>::new(),#	a check id ignores the checks it declares it depends on, so a changed dependency leaves it unchanged
identity_compiler_ignored	identity.rs	s#"compiler_identity": compiler_identity,#"compiler_identity": "",#	a different compiler gives the same check id
identity_flags_ignored	identity.rs	s#"flags": flags,#"flags": Vec::<String>::new(),#	different build flags give the same check id
identity_dependency_ids_unsorted	identity.rs	s#^    deps.sort();#    let _ = \&deps;#	the order the dependency ids are given in changes the check id
identity_missing_input_dropped	identity.rs	s#rows.entry(spec.to_string()).or_insert(None);#let _ = spec;#	a declared input that matches no tracked file leaves no trace in the identity
identity_golden_not_hashed	identity.rs	s#goldens.push(sha256_hex(&bytes));#let _ = \&bytes;#	editing the golden file does not change the check id
planner_drops_dependencies	identity.rs	s#graph.with_dependencies(&seeds)#seeds.into_iter().collect()#	path filtering selects the changed gate but drops the gates it declares it depends on
v2_tolerance_without_bounded_allowed	manifest.rs	s#if tolerance.is_some() \&\& exactness != Exactness::Bounded {#if false {#	a tolerance is accepted on an EXACT check
v2_analog_eligible_for_exact	manifest.rs	s#if is_analog(b) \&\& exactness == Exactness::Exact {#if false {#	an analog backend may be eligible for an EXACT check
v2_canonical_outside_eligible	manifest.rs	s#if !eligible.contains(&canonical) {#if false {#	a canonical backend that is not eligible is accepted
v1_accepts_v2_keys	manifest.rs	s#entries.iter().find(|e| V2_KEYS.contains(\&e.key.as_str()))#entries.iter().find(|_e| false)#	a v1 manifest may use v2 keys, so it is no longer strictly v1
sig_not_checked	bundle.rs	s#vk.verify_strict(&bytes, &signature)#Ok::<(), ed25519_dalek::SignatureError>(())#	the bundle signature is never checked
commit_not_checked	bundle.rs	s#if commit != expect.commit {#if false {#	a bundle for another commit is accepted
repo_not_checked	bundle.rs	s#if repo != expect.repository {#if false {#	a bundle for another repository is accepted
key_not_checked	bundle.rs	s#if pubkey != expect.pubkey_hex.trim() {#if false {#	a bundle signed by an unknown key is accepted
not_run_counts_as_pass	bundle.rs	s#if !(ran \&\& verdict == "PASS") {#if verdict == "FAIL" {#	a required check that did not run no longer blocks PASS
